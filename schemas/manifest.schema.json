{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenDSS/AltDSS Library Manifest",
  "type": "object",
  "properties": {
    "library_version": {"type": "string", "const": "0.1.0"},
    "build_date": {"type": "string", "format": "date"},
    "target_environment": {
      "type": "object",
      "properties": {
        "python": {"type": "string", "pattern": "^>=3\\.7"},
        "numpy": {"type": "string", "pattern": "^>=1\\.21"},
        "altdss": {"type": "string", "const": "0.2.4"},
        "dss_python": {"type": "string", "const": "0.15.7"},
        "dss_capi_backend": {"type": "string", "const": "0.14.5"}
      },
      "required": ["python", "altdss", "dss_capi_backend"]
    },
    "namespaces": {
      "type": "array",
      "items": {"type": "string", "enum": ["opendss", "altdss", "dss", "opendssdirect", "dss_capi"]}
    },
    "validation_status": {"type": "string", "enum": ["Phase 2 Extraction", "Phase 3 Curation", "Phase 4 Validated"]}
  },
  "required": ["library_version", "target_environment", "namespaces"]
}