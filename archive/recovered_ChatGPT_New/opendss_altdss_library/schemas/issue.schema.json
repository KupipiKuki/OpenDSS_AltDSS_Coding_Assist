{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "common.schema.json#/$defs/evidenceRecordFields",
  "title": "Issue or Troubleshooting Record",
  "type": "object",
  "properties": {
    "kind": { "const": "issue" },
    "title": { "type": "string", "minLength": 1 },
    "symptom": { "type": "string", "minLength": 1 },
    "cause": { "type": ["string", "null"] },
    "diagnostic_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safe_fix": { "type": ["string", "null"] },
    "affected_versions": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "unresolved", "superseded"]
    }
  },
  "required": ["kind", "title", "symptom", "status"],
  "unevaluatedProperties": false
}
