{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSS and AltDSS Example Catalog",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "example_id": {"type": "string"},
      "task_description": {"type": "string"},
      "language": {"type": "string", "enum": ["dss", "python_altdss", "python_dss", "python_opendssdirect"]},
      "code_snippet": {"type": "string"},
      "file": {"type": "string", "minLength": 1, "description": "Example file path relative to the library directory."},
      "object_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "dependencies": {"type": "array", "items": {"type": "string"}},
      "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "expected_result": {"type": "string"},
      "execution_status": {"type": "string", "enum": ["Example-only", "Observed-working"]},
      "environment": {
        "type": "object",
        "properties": {
          "python_version": {"type": "string"},
          "altdss_version": {"type": "string"},
          "dss_python_version": {"type": "string"},
          "backend_version": {"type": "string"},
          "platform": {"type": "string", "description": "Operating system, release, and architecture of the recorded run."},
          "date": {"type": "string", "format": "date", "description": "Date the recorded run was executed."}
        }
      },
      "provenance": {
        "type": "object",
        "properties": {
          "source_url": {"type": "string"},
          "access_date": {"type": "string", "format": "date"}
        }
      },
      "evidence_label": {"type": "string", "enum": ["Official-current", "Official-versioned", "Observed-working", "Observed-export", "Example-only", "Inferred", "Unverified"]}
    },
    "required": ["example_id", "task_description", "language", "execution_status", "evidence_label"],
    "anyOf": [
      {"required": ["file"]},
      {"required": ["code_snippet"]}
    ]
  }
}
