{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Line and LineCode Workflow Source Index",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "kind", "title", "publisher", "url", "version_or_ref", "accessed", "topics", "scope"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "kind": {"enum": ["documentation", "source", "release-notes", "package-metadata"]},
      "title": {"type": "string", "minLength": 1},
      "publisher": {"type": "string", "minLength": 1},
      "url": {"type": "string", "format": "uri"},
      "version_or_ref": {"type": ["string", "null"], "minLength": 1},
      "accessed": {"type": "string", "format": "date"},
      "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "scope": {"type": "string", "minLength": 1}
    },
    "additionalProperties": false
  }
}
