{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AltDSS-Python API Catalog",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "module_path": {"type": "string", "description": "Import or context member path, using the exact case in the target source."},
      "class_name": {"type": "string"},
      "target_version": {"type": "string", "const": "0.2.4"},
      "description": {"type": "string"},
      "methods": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "signature": {"type": "string"},
            "batch_behavior": {"type": "string", "description": "How the method acts on collections/batches"},
            "description": {"type": "string"},
            "evidence_label": {"type": "string", "enum": ["Official-current", "Official-versioned", "Observed-working", "Observed-export", "Example-only", "Inferred", "Unverified"]}
          },
          "required": ["name", "signature", "evidence_label"]
        }
      },
      "properties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "type_hint": {"type": "string"},
            "description": {"type": "string"},
            "evidence_label": {"type": "string", "enum": ["Official-current", "Official-versioned", "Observed-working", "Observed-export", "Example-only", "Inferred", "Unverified"]}
          },
          "required": ["name", "evidence_label"]
        }
      },
      "evidence_label": {"type": "string", "enum": ["Official-current", "Official-versioned", "Observed-working", "Observed-export", "Example-only", "Inferred", "Unverified"]}
    },
    "required": ["module_path", "target_version", "evidence_label"]
  }
}
