[
  {
    "element_class": "Circuit",
    "epri_doc_url": "https://opendss.epri.com/Circuit.html",
    "properties": [
      {
        "name": "name",
        "data_type": "string",
        "default_value": null,
        "description": "Circuit identifier in New Circuit.<name>. Read it back from the AltDSS context Name.",
        "evidence_label": "Official-versioned",
        "source_refs": [
          "https://github.com/dss-extensions/AltDSS-Python/blob/0.2.4/altdss/AltDSS.py#L426-L450",
          "https://github.com/dss-extensions/dss_capi/blob/0.14.5/src/Executive/ExecHelper.pas#L227-L262",
          "https://github.com/dss-extensions/dss_capi/blob/0.14.5/src/Common/DSSGlobals.pas#L426-L440"
        ]
      }
    ],
    "required_properties": [
      "name"
    ],
    "altdss_mapping": "AltDSS context Commands(\"New Circuit.<name> ...\")",
    "evidence_label": "Official-versioned",
    "target_versions": {
      "altdss_python": "0.2.4",
      "dss_python": "0.15.7",
      "dss_python_backend": "0.14.5",
      "opendss_documentation": "EPRI online documentation; page version not stated"
    },
    "target_support": {
      "altdss_python": true
    },
    "sources": [
      {
        "title": "EPRI Circuit interface",
        "url": "https://opendss.epri.com/Circuit.html",
        "accessed": "2026-11-21",
        "scope": "Classic interface context."
      },
      {
        "title": "AltDSS context commands",
        "url": "https://github.com/dss-extensions/AltDSS-Python/blob/0.2.4/altdss/AltDSS.py",
        "accessed": "2026-11-21",
        "scope": "Pinned Python command path."
      },
      {
        "title": "DSS C-API circuit container",
        "url": "https://github.com/dss-extensions/dss_capi/blob/0.14.5/src/Common/Circuit.pas",
        "accessed": "2026-11-21",
        "scope": "TDSSCircuit is a container."
      },
      {
        "title": "DSS C-API New Circuit routing",
        "url": "https://github.com/dss-extensions/dss_capi/blob/0.14.5/src/Common/DSSGlobals.pas",
        "accessed": "2026-11-21",
        "scope": "Creates source and routes creation properties."
      }
    ],
    "property_requirements": {
      "required": [
        "name"
      ],
      "conditional": [
        {
          "when": "supplying source parameters on New Circuit",
          "requirement": "Command arguments after the circuit name configure the new Vsource.source. See its rows for fields and units.",
          "source_refs": [
            "https://github.com/dss-extensions/dss_capi/blob/0.14.5/src/Common/DSSGlobals.pas#L426-L440"
          ]
        }
      ]
    },
    "notes": [
      "Circuit is a context command in the pinned Python interface. The engine stores the circuit in TDSSCircuit without a Circuit property enum.",
      "Read routed electrical parameters on ctx.Vsource[\"source\"]. Use ctx.Solution for solution settings and ctx.Bus for bus readback after building the bus list or solving."
    ]
  },
